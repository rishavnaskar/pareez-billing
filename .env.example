# Firebase web app config (Project settings → General → Your apps → Web app).
# These are exposed to the browser by design (NEXT_PUBLIC_*); access control
# is enforced by Firestore security rules, not by hiding these values.
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Optional: point the app at a local Firestore emulator (host:port)
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=localhost:8080

# --- Admin scripts only (not used by the app) ---
# Used by: node --env-file=.env scripts/set-user-claims.js
# Comma-separated admin emails
ADMIN_EMAILS=admin@example.com
# Comma-separated email:branchId pairs for branch-scoped users
BRANCH_USER_CLAIMS=user1@example.com:branchDocId1,user2@example.com:branchDocId2
# Comma-separated branchDocId:Name pairs for the branch seeding script
SEED_BRANCHES=branchDocId1:Branch One,branchDocId2:Branch Two
# Branch seed data: entries ';'-separated, fields '|'-separated (name|address|phone)
SEED_BRANCH_DETAILS=Branch One|12 Example St, City 700001|+91 9876543210;Branch Two|34 Sample Rd, City 700002|+91 9876543210
